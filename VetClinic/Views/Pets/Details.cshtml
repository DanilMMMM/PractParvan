@model VetClinic.Models.Pet
@{
    ViewData["Title"] = $"Медкарта: {Model.Name}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Питомцы</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-dark mb-0">
            <i class="bi bi-file-earmark-medical text-teal me-2" style="color: #0d9488;"></i>
            Электронная медицинская карта: @Model.Name
        </h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Visits" asp-action="Create" asp-route-petId="@Model.Id" class="btn btn-teal">
            <i class="bi bi-calendar2-plus me-1"></i> Записать на приём
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i> Редактировать
        </a>
        <a asp-action="Index" class="btn btn-light border">
            <i class="bi bi-arrow-left me-1"></i> Назад
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Pet Passport Card -->
    <div class="col-lg-4">
        <div class="card card-custom p-4 bg-white border">
            <div class="text-center mb-3">
                <div class="rounded-circle bg-teal text-white d-inline-flex align-items-center justify-content-center p-3 fs-1 mb-2" 
                     style="background-color: #0d9488; width: 80px; height: 80px;">
                    <i class="bi bi-github"></i>
                </div>
                <h3 class="fw-bold mb-0 text-dark">@Model.Name</h3>
                <span class="badge bg-secondary">@Model.PetType?.Name</span>
            </div>

            <hr>

            <dl class="row mb-0 small">
                <dt class="col-5 text-muted">Порода:</dt>
                <dd class="col-7 fw-semibold">@(Model.Breed ?? "Метис")</dd>

                <dt class="col-5 text-muted">Пол:</dt>
                <dd class="col-7 fw-semibold">@Model.Gender</dd>

                <dt class="col-5 text-muted">Возраст:</dt>
                <dd class="col-7 fw-semibold">@Model.AgeDisplay</dd>

                <dt class="col-5 text-muted">Дата рождения:</dt>
                <dd class="col-7 fw-semibold">@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("dd.MM.yyyy") : "Не указана")</dd>

                <dt class="col-5 text-muted">Вес:</dt>
                <dd class="col-7 fw-semibold">@(Model.Weight.HasValue ? $"{Model.Weight.Value} кг" : "Не указан")</dd>

                <dt class="col-5 text-muted">Владелец:</dt>
                <dd class="col-7 fw-semibold">@(Model.Owner?.FullName ?? "—")</dd>

                <dt class="col-5 text-muted">Телефон:</dt>
                <dd class="col-7 fw-semibold">@(Model.Owner?.Phone ?? "—")</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(Model.MedicalNotes))
            {
                <div class="mt-3 p-3 bg-light rounded border">
                    <strong class="d-block text-dark small mb-1"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Особенности здоровья:</strong>
                    <div class="small text-secondary">@Model.MedicalNotes</div>
                </div>
            }
        </div>
    </div>

    <!-- Medical History Timeline -->
    <div class="col-lg-8">
        <div class="card card-custom p-4 bg-white border">
            <h4 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history me-2 text-teal" style="color: #0d9488;"></i> История приёмов и назначений</h4>

            @if (!Model.Visits.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-journal-medical fs-1"></i>
                    <p class="mt-2 mb-0">Приёмов в клинике пока не зарегистрировано.</p>
                </div>
            }
            else
            {
                <div class="timeline">
                    @foreach (var visit in Model.Visits.OrderByDescending(v => v.VisitDate))
                    {
                        <div class="p-3 mb-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge @visit.StatusBadgeClass me-2">@visit.Status</span>
                                    <strong class="text-dark">@visit.VisitDate.ToString("dd.MM.yyyy HH:mm")</strong>
                                    <span class="text-muted ms-2">— @visit.Service?.Name</span>
                                </div>
                                <span class="fw-bold text-dark">@visit.TotalCost.ToString("N0") ₽</span>
                            </div>

                            <div class="small text-muted mb-2">
                                <i class="bi bi-person-badge me-1"></i> Врач: <strong>@visit.Veterinarian?.FullName</strong> (@(visit.Veterinarian?.Specialization ?? "Ветеринар"))
                            </div>

                            @if (!string.IsNullOrWhiteSpace(visit.Symptoms))
                            {
                                <div class="small mb-1">
                                    <span class="text-muted">Жалобы:</span> @visit.Symptoms
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(visit.Diagnosis))
                            {
                                <div class="small mb-1 text-danger-emphasis bg-white p-2 rounded border">
                                    <strong>Диагноз:</strong> @visit.Diagnosis
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(visit.Treatment))
                            {
                                <div class="small mb-1 bg-white p-2 rounded border text-dark">
                                    <strong>Назначения и лечение:</strong>
                                    <div class="text-secondary">@visit.Treatment</div>
                                </div>
                            }

                            <div class="mt-2 pt-2 border-top d-flex justify-content-end gap-2">
                                <a asp-controller="Visits" asp-action="Details" asp-route-id="@visit.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i> Протокол приёма
                                </a>
                                @if ((User.IsInRole("Ветеринар") || User.IsInRole("Администратор")) && visit.Status != "Завершён")
                                {
                                    <a asp-controller="Visits" asp-action="Conduct" asp-route-id="@visit.Id" class="btn btn-sm btn-teal">
                                        <i class="bi bi-clipboard2-pulse me-1"></i> Провести приём
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
