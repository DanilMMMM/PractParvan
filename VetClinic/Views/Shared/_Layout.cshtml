@using System.Security.Claims
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ВетЗабота | Ветеринарная клиника</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top py-2">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon-wrapper">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </span>
                    <span>ВетЗабота</span>
                </a>
                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" 
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Навигация">
                    <i class="bi bi-list fs-2 text-white"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Services">
                                <i class="bi bi-card-checklist me-1"></i> Услуги и цены
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contacts">
                                <i class="bi bi-geo-alt me-1"></i> Контакты
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Pets" asp-action="Index">
                                    <i class="bi bi-github me-1"></i>
                                    @(User.IsInRole("Клиент") ? "Мои питомцы" : "Пациенты")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Visits" asp-action="Index">
                                    <i class="bi bi-calendar2-check me-1"></i>
                                    @(User.IsInRole("Клиент") ? "Мои приёмы" : "Журнал приёмов")
                                </a>
                            </li>

                            @if (User.IsInRole("Администратор"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-warning fw-semibold" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock me-1"></i> Администрирование
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark shadow-lg border-secondary" aria-labelledby="adminMenu">
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index">
                                                <i class="bi bi-speedometer2 text-emerald me-2" style="color: #34d399;"></i> Панель управления
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Users">
                                                <i class="bi bi-people text-info me-2"></i> Пользователи и роли
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Services">
                                                <i class="bi bi-tags text-warning me-2"></i> Каталог услуг
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider border-secondary"></li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Visits" asp-action="Index">
                                                <i class="bi bi-journal-medical text-primary me-2"></i> Все приёмы клиники
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var role = User.FindFirstValue(ClaimTypes.Role) ?? "Клиент";
                            var badgeClass = role switch
                            {
                                "Администратор" => "badge-role-admin",
                                "Ветеринар" => "badge-role-vet",
                                _ => "badge-role-client"
                            };

                            <li class="nav-item d-none d-md-block">
                                <a asp-controller="Visits" asp-action="Create" class="btn btn-sm btn-teal rounded-pill px-3">
                                    <i class="bi bi-plus-circle me-1"></i> Записаться на приём
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="badge @badgeClass">@role</span>
                                    <span class="fw-semibold text-white">@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg border-secondary" aria-labelledby="userMenu">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person me-2"></i> Личный кабинет
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Клиент"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Pets" asp-action="Index">
                                                <i class="bi bi-hearts text-danger me-2"></i> Мои питомцы
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Выйти из системы
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-dark-glass btn-sm px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Войти
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-teal btn-sm px-3" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Регистрация
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4 rounded-4" 
                 style="background: #ecfdf5; color: #047857; border-left: 5px solid #10b981 !important;" role="alert">
                <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Закрыть"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4 rounded-4" 
                 style="background: #fff1f2; color: #be123c; border-left: 5px solid #f43f5e !important;" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Закрыть"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <span class="brand-icon-wrapper" style="width: 28px; height: 28px; font-size: 0.95rem;">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </span>
                        <strong class="text-white fs-5">ВетЗабота</strong>
                    </div>
                    <small class="text-secondary d-block">
                        Индивидуальная практическая работа &bull; Вариант 16 &bull; Студент: <strong class="text-white">Макаренко Данил Александрович</strong>, гр. <strong class="text-white">413 ТТИиП</strong>
                    </small>
                </div>
                <div class="col-md-6 text-center text-md-end text-secondary small">
                    <div class="mb-1"><i class="bi bi-telephone text-emerald me-1" style="color: #34d399;"></i> Круглосуточная регистратура: +373 (22) 85-35-35 | +373 69 112 003</div>
                    <div><i class="bi bi-geo-alt text-emerald me-1" style="color: #34d399;"></i> Молдова, г. Кишинёв, ул. Алеку Руссо, д. 16</div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
