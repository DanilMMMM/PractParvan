@model VetClinic.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Авторизация в системе";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-7 col-lg-5">
        <div class="card card-custom p-4 bg-white border">
            <div class="text-center mb-4">
                <div class="display-6 text-teal mb-2" style="color: #0d9488;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h3 class="fw-bold text-dark">Вход в систему</h3>
                <p class="text-muted small">Введите ваши учётные данные для доступа</p>
            </div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Login" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="Login" class="form-control" id="loginInput" placeholder="Введите логин" />
                    </div>
                    <span asp-validation-for="Login" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" class="form-control" id="passwordInput" placeholder="Введите пароль" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label text-muted small"></label>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-teal btn-lg">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Войти
                    </button>
                </div>

                <div class="text-center small text-muted">
                    Нет аккаунта? <a asp-action="Register" class="text-decoration-none fw-semibold">Зарегистрироваться</a>
                </div>
            </form>

            <!-- Quick Demo Accounts Helper for Evaluation -->
            <div class="mt-4 pt-3 border-top">
                <span class="text-muted small fw-semibold d-block mb-2 text-center">
                    <i class="bi bi-stars text-warning me-1"></i> Быстрый вход для проверки преподавателем:
                </span>
                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-outline-danger btn-sm text-start" onclick="fillCredentials('admin', 'admin123')">
                        <i class="bi bi-shield-fill-exclamation me-1"></i> <strong>Администратор:</strong> admin / admin123
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm text-start" onclick="fillCredentials('vet_ivanov', 'vet123')">
                        <i class="bi bi-bandaid me-1"></i> <strong>Ветеринар:</strong> vet_ivanov / vet123
                    </button>
                    <button type="button" class="btn btn-outline-success btn-sm text-start" onclick="fillCredentials('client_danil', 'client123')">
                        <i class="bi bi-person-heart me-1"></i> <strong>Клиент:</strong> client_danil / client123
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(login, password) {
            document.getElementById('loginInput').value = login;
            document.getElementById('passwordInput').value = password;
        }
    </script>
}
