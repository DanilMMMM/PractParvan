@model VetClinic.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Авторизация в системе";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-5">
        <div class="card card-custom p-4 p-md-5 bg-white border">
            <div class="text-center mb-4">
                <span class="brand-icon-wrapper mb-3" style="width: 52px; height: 52px; font-size: 1.6rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </span>
                <h3 class="fw-bold text-dark mb-1">Вход в систему</h3>
                <p class="text-secondary small mb-0">Информационная система ветеринарной клиники «ВетЗабота»</p>
            </div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 border-0 rounded-3"></div>

                <div class="mb-3">
                    <label asp-for="Login" class="form-label fw-semibold small text-secondary"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="Login" class="form-control" id="loginInput" placeholder="Введите логин" />
                    </div>
                    <span asp-validation-for="Login" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small text-secondary"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" class="form-control" id="passwordInput" placeholder="Введите пароль" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label text-secondary small"></label>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-teal btn-lg">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Войти в систему
                    </button>
                </div>

                <div class="text-center small text-secondary">
                    Ещё нет учётной записи? <a asp-action="Register" class="text-decoration-none fw-bold" style="color: #059669;">Зарегистрироваться</a>
                </div>
            </form>

            <!-- Quick Demo Helper for Evaluation -->
            <div class="mt-4 pt-4 border-top">
                <div class="d-flex align-items-center gap-2 mb-3 justify-content-center">
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">
                        <i class="bi bi-lightning-charge-fill me-1"></i> Для преподавателя: быстрый вход в 1 клик
                    </span>
                </div>

                <div class="d-flex flex-column gap-2">
                    <div class="quick-test-btn" onclick="fillCredentials('admin', 'admin123')">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge badge-role-admin">Администратор</span>
                            <span class="fw-semibold text-dark">admin</span>
                        </div>
                        <span class="text-muted small">пароль: admin123 &rarr;</span>
                    </div>

                    <div class="quick-test-btn" onclick="fillCredentials('vet_ivanov', 'vet123')">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge badge-role-vet">Ветеринар</span>
                            <span class="fw-semibold text-dark">vet_ivanov</span>
                        </div>
                        <span class="text-muted small">пароль: vet123 &rarr;</span>
                    </div>

                    <div class="quick-test-btn" onclick="fillCredentials('client_danil', 'client123')">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge badge-role-client">Клиент</span>
                            <span class="fw-semibold text-dark">client_danil</span>
                        </div>
                        <span class="text-muted small">пароль: client123 &rarr;</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(login, password) {
            document.getElementById('loginInput').value = login;
            document.getElementById('passwordInput').value = password;
        }
    </script>
}
