@model VetClinic.ViewModels.VisitCreateViewModel
@{
    ViewData["Title"] = "Запись на приём к ветеринару";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom p-4 bg-white border">
            <div class="d-flex align-items-center gap-3 border-bottom pb-3 mb-4">
                <div class="rounded-circle bg-teal text-white d-flex align-items-center justify-content-center fs-2" 
                     style="width: 60px; height: 60px; background-color: #0d9488;">
                    <i class="bi bi-calendar-plus-fill"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark">Запись на ветеринарный приём</h3>
                    <p class="text-muted small mb-0">Выберите питомца, специалиста, требуемую услугу и удобное время</p>
                </div>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="PetId" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-github"></i></span>
                        <select asp-for="PetId" class="form-select" asp-items="ViewBag.PetId">
                            <option value="">-- Выберите питомца из списка --</option>
                        </select>
                    </div>
                    <span asp-validation-for="PetId" class="text-danger small"></span>
                    <div class="form-text">
                        Нет в списке? <a asp-controller="Pets" asp-action="Create">Добавьте нового питомца</a> перед записью.
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ServiceId" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-card-checklist"></i></span>
                            <select asp-for="ServiceId" class="form-select" asp-items="ViewBag.ServiceId">
                                <option value="">-- Выберите услугу --</option>
                            </select>
                        </div>
                        <span asp-validation-for="ServiceId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="VeterinarianId" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                            <select asp-for="VeterinarianId" class="form-select" asp-items="ViewBag.VeterinarianId">
                                <option value="">-- Выберите врача --</option>
                            </select>
                        </div>
                        <span asp-validation-for="VeterinarianId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="VisitDate" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-clock"></i></span>
                        <input asp-for="VisitDate" class="form-control" type="datetime-local" 
                               value="@Model.VisitDate.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <span asp-validation-for="VisitDate" class="text-danger small"></span>
                    <div class="form-text">Клиника работает ежедневно с 08:00 до 22:00.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Symptoms" class="form-label fw-semibold"></label>
                    <textarea asp-for="Symptoms" class="form-control" rows="3" 
                              placeholder="Кратко опишите причину обращения: вялость, кашель, вакцинация, травма, изменение аппетита..."></textarea>
                    <span asp-validation-for="Symptoms" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Отмена
                    </a>
                    <button type="submit" class="btn btn-teal px-4">
                        <i class="bi bi-check2-circle me-1"></i> Подтвердить запись
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
