@model IEnumerable<VetClinic.Models.Service>
@{
    ViewData["Title"] = "Главная";
    var doctors = ViewBag.Doctors as List<VetClinic.Models.User> ?? new List<VetClinic.Models.User>();
}

<!-- Hero Section -->
<div class="p-5 mb-4 bg-white rounded-3 shadow-sm border border-light">
    <div class="container-fluid py-4">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-teal text-white mb-2 px-3 py-2" style="background-color: #0d9488;">
                    <i class="bi bi-shield-check me-1"></i> Лицензированная ветеринарная клиника
                </span>
                <h1 class="display-5 fw-bold text-dark mt-2 mb-3">Забота и здоровье ваших любимых питомцев</h1>
                <p class="lead text-secondary mb-4">
                    Круглосуточная квалифицированная помощь, современное диагностическое оборудование,
                    индивидуальный подход к каждому четвероногому пациенту и личный кабинет для владельцев.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Visits" asp-action="Create" class="btn btn-teal btn-lg px-4 shadow-sm">
                        <i class="bi bi-calendar2-plus me-1"></i> Записаться на приём
                    </a>
                    <a asp-controller="Home" asp-action="Services" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-card-text me-1"></i> Прейскурант услуг
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center mt-4 mt-lg-0">
                <div class="p-4 bg-light rounded-4 border">
                    <div class="display-1 text-teal mb-2" style="color: #0d9488;">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <h4 class="fw-bold text-dark">«ВетЗабота»</h4>
                    <p class="text-muted small mb-0">Система учёта животных, электронных медкнижек и визитов</p>
                    <hr class="my-3">
                    <div class="text-start small text-secondary">
                        <div class="mb-1"><i class="bi bi-check2-circle text-success me-2"></i>Электронная медкарта каждого питомца</div>
                        <div class="mb-1"><i class="bi bi-check2-circle text-success me-2"></i>История назначений и диагнозов</div>
                        <div><i class="bi bi-check2-circle text-success me-2"></i>Удобная онлайн-запись к профильным врачам</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Metrics Counters -->
<div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
        <div class="card card-custom p-3 text-center bg-white">
            <h2 class="fw-bold text-teal mb-0" style="color: #0d9488;">@ViewBag.TotalPetsCount</h2>
            <p class="text-muted small mb-0 mt-1"><i class="bi bi-heart me-1"></i> Питомцев в базе</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-custom p-3 text-center bg-white">
            <h2 class="fw-bold text-primary mb-0">@ViewBag.TotalVisitsCount</h2>
            <p class="text-muted small mb-0 mt-1"><i class="bi bi-clipboard2-pulse me-1"></i> Приёмов проведено</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-custom p-3 text-center bg-white">
            <h2 class="fw-bold text-success mb-0">@ViewBag.TotalClientsCount</h2>
            <p class="text-muted small mb-0 mt-1"><i class="bi bi-people me-1"></i> Довольных клиентов</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-custom p-3 text-center bg-white">
            <h2 class="fw-bold text-warning mb-0">24/7</h2>
            <p class="text-muted small mb-0 mt-1"><i class="bi bi-clock-history me-1"></i> Приём и стационар</p>
        </div>
    </div>
</div>

<!-- Services Section -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <span class="text-uppercase fw-semibold text-muted small">Наши услуги</span>
            <h2 class="fw-bold text-dark mb-0">Популярные направления лечения</h2>
        </div>
        <a asp-controller="Home" asp-action="Services" class="text-decoration-none fw-semibold" style="color: #0d9488;">
            Все услуги клиники <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row g-4">
        @foreach (var s in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-custom h-100 p-3 bg-white d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-dark mb-0">@s.Name</h5>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-clock me-1"></i> @s.DurationMinutes мин
                            </span>
                        </div>
                        <p class="text-muted small mb-3">@s.Description</p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <span class="fs-5 fw-bold text-dark">@s.Price.ToString("N0") ₽</span>
                        <a asp-controller="Visits" asp-action="Create" asp-route-serviceId="@s.Id" class="btn btn-sm btn-outline-teal">
                            <i class="bi bi-calendar-plus me-1"></i> Записаться
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Doctors Section -->
<div class="mb-5">
    <div class="mb-4">
        <span class="text-uppercase fw-semibold text-muted small">Наша команда</span>
        <h2 class="fw-bold text-dark mb-0">Ветеринарные врачи и специалисты</h2>
    </div>

    <div class="row g-4">
        @foreach (var doc in doctors)
        {
            <div class="col-md-6">
                <div class="card card-custom p-4 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-teal text-white d-flex align-items-center justify-content-center" 
                             style="width: 65px; height: 65px; background-color: #0d9488; font-size: 1.8rem;">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">@doc.FullName</h5>
                            <span class="badge bg-primary text-white mb-1">
                                @(doc.Specialization ?? "Ветеринарный врач общей практики")
                            </span>
                            <div class="text-muted small">
                                <i class="bi bi-envelope me-1"></i> @doc.Email
                                @if (!string.IsNullOrEmpty(doc.Phone))
                                {
                                    <span class="ms-2"><i class="bi bi-telephone me-1"></i> @doc.Phone</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Why Choose Us -->
<div class="p-4 p-md-5 rounded-4 bg-white shadow-sm mb-5">
    <div class="row g-4 align-items-center">
        <div class="col-lg-6">
            <span class="text-uppercase fw-semibold text-muted small">Преимущества</span>
            <h3 class="fw-bold mb-3">Почему владельцы доверяют здоровье питомцев нам?</h3>
            <ul class="list-unstyled mb-0">
                <li class="d-flex align-items-start mb-3">
                    <i class="bi bi-check-circle-fill text-success fs-5 me-3"></i>
                    <div>
                        <strong class="text-dark">Собственная экспресс-лаборатория</strong>
                        <p class="text-muted small mb-0">Результаты общих и биохимических анализов готовы в течение 30 минут.</p>
                    </div>
                </li>
                <li class="d-flex align-items-start mb-3">
                    <i class="bi bi-check-circle-fill text-success fs-5 me-3"></i>
                    <div>
                        <strong class="text-dark">Бережный приём без стресса (Fear Free)</strong>
                        <p class="text-muted small mb-0">Специальные методики обращения с кошками и собаками снижают тревожность при осмотре.</p>
                    </div>
                </li>
                <li class="d-flex align-items-start">
                    <i class="bi bi-check-circle-fill text-success fs-5 me-3"></i>
                    <div>
                        <strong class="text-dark">Прозрачная медицинская история</strong>
                        <p class="text-muted small mb-0">Вся информация о приёмах, вакцинациях и лечении доступна онлайн в личном кабинете.</p>
                    </div>
                </li>
            </ul>
        </div>
        <div class="col-lg-6">
            <div class="p-4 rounded-3 border bg-light text-center">
                <i class="bi bi-calendar-event fs-1 text-teal" style="color: #0d9488;"></i>
                <h4 class="fw-bold mt-2">Нужна консультация ветеринара?</h4>
                <p class="text-secondary small mb-3">Запишитесь на удобное время через сайт или обратитесь в регистратуру</p>
                <div class="d-grid gap-2 col-md-8 mx-auto">
                    <a asp-controller="Visits" asp-action="Create" class="btn btn-teal">
                        <i class="bi bi-pen me-1"></i> Оформить запись онлайн
                    </a>
                    <a href="tel:+79005553535" class="btn btn-outline-secondary">
                        <i class="bi bi-telephone me-1"></i> Позвонить в клинику
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
