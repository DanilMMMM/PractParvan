@model IEnumerable<VetClinic.Models.Service>
@{
    ViewData["Title"] = "Главная";
    var doctors = ViewBag.Doctors as List<VetClinic.Models.User> ?? new List<VetClinic.Models.User>();
}

<!-- Modern Hero Section -->
<div class="hero-banner mb-5">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <div class="hero-pill mb-3">
                <i class="bi bi-shield-check"></i>
                <span>Инновационный ветеринарный центр &bull; 24/7</span>
            </div>
            <h1 class="hero-title">
                Экспертная забота о <span class="text-gradient-emerald">здоровье</span> ваших питомцев
            </h1>
            <p class="lead text-light opacity-75 mb-4" style="max-width: 580px; font-size: 1.1rem; line-height: 1.6;">
                Круглосуточный приём, экспертная хирургия, электронные медицинские карты и личный кабинет владельца для контроля всех визитов и назначений.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Visits" asp-action="Create" class="btn btn-teal btn-lg px-4 shadow">
                    <i class="bi bi-calendar2-plus me-2"></i> Записаться онлайн
                </a>
                <a asp-controller="Home" asp-action="Services" class="btn btn-dark-glass btn-lg px-4">
                    <i class="bi bi-card-checklist me-2"></i> Каталог услуг и цены
                </a>
            </div>
        </div>

        <div class="col-lg-5 mt-4 mt-lg-0">
            <div class="hero-card-glass">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="brand-icon-wrapper" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        <i class="bi bi-hospital"></i>
                    </span>
                    <div>
                        <h5 class="fw-bold text-white mb-0">ВетЗабота &bull; Клиника</h5>
                        <small class="text-emerald" style="color: #34d399;"><i class="bi bi-dot"></i> Система онлайн-учёта</small>
                    </div>
                </div>
                <p class="text-light opacity-75 small mb-3">
                    Все данные о здоровье, прививках и процедурах сохраняются в единой защищённой базе данных клиники.
                </p>
                <div class="d-flex flex-column gap-2 small">
                    <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background: rgba(255,255,255,0.05);">
                        <i class="bi bi-check-circle-fill text-emerald" style="color: #34d399;"></i>
                        <span>Электронная медкарта каждого животного</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background: rgba(255,255,255,0.05);">
                        <i class="bi bi-check-circle-fill text-emerald" style="color: #34d399;"></i>
                        <span>Протоколы осмотра с печатью и подписью врача</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background: rgba(255,255,255,0.05);">
                        <i class="bi bi-check-circle-fill text-emerald" style="color: #34d399;"></i>
                        <span>Удобный доступ для клиентов и докторов</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modern Stat Boxes -->
<div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
        <div class="stat-box d-flex align-items-center gap-3">
            <div class="stat-icon stat-icon-emerald">
                <i class="bi bi-github"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalPetsCount</h3>
                <small class="text-secondary fw-semibold">Пациентов в базе</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-box d-flex align-items-center gap-3">
            <div class="stat-icon stat-icon-indigo">
                <i class="bi bi-clipboard2-pulse"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalVisitsCount</h3>
                <small class="text-secondary fw-semibold">Приёмов проведено</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-box d-flex align-items-center gap-3">
            <div class="stat-icon stat-icon-amber">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalClientsCount</h3>
                <small class="text-secondary fw-semibold">Владельцев животных</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-box d-flex align-items-center gap-3">
            <div class="stat-icon stat-icon-rose">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">24 / 7</h3>
                <small class="text-secondary fw-semibold">Круглосуточный стационар</small>
            </div>
        </div>
    </div>
</div>

<!-- Popular Services Grid -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <span class="text-uppercase fw-bold text-emerald small" style="color: #059669; letter-spacing: 0.05em;">Прейскурант</span>
            <h2 class="fw-bold text-dark mb-0">Популярные направления лечения</h2>
        </div>
        <a asp-controller="Home" asp-action="Services" class="btn btn-outline-teal btn-sm">
            Все услуги <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        @foreach (var s in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-custom card-interactive h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-light text-secondary border rounded-pill px-3 py-2">
                                <i class="bi bi-stopwatch me-1"></i> @s.DurationMinutes мин
                            </span>
                            <span class="fs-4 fw-bold text-dark">@s.Price.ToString("N0") ₽</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">@s.Name</h5>
                        <p class="text-secondary small mb-3" style="line-height: 1.6;">@s.Description</p>
                    </div>
                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="small text-muted"><i class="bi bi-shield-check text-success me-1"></i> Гарантия стерильности</span>
                        <a asp-controller="Visits" asp-action="Create" asp-route-serviceId="@s.Id" class="btn btn-sm btn-teal">
                            Записаться
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Doctors Team Section -->
<div class="mb-5">
    <div class="mb-4">
        <span class="text-uppercase fw-bold text-emerald small" style="color: #059669; letter-spacing: 0.05em;">Специалисты</span>
        <h2 class="fw-bold text-dark mb-0">Ветеринарные врачи клиники</h2>
    </div>

    <div class="row g-4">
        @foreach (var doc in doctors)
        {
            <div class="col-md-6">
                <div class="card card-custom p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="doctor-avatar">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">@doc.FullName</h5>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mb-2 px-3 py-1">
                                @(doc.Specialization ?? "Ветеринарный врач")
                            </span>
                            <div class="text-secondary small">
                                <div><i class="bi bi-envelope me-1 text-muted"></i> @doc.Email</div>
                                @if (!string.IsNullOrEmpty(doc.Phone))
                                {
                                    <div><i class="bi bi-telephone me-1 text-muted"></i> @doc.Phone</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Trust Banner -->
<div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm mb-5">
    <div class="row g-4 align-items-center">
        <div class="col-lg-7">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill mb-2">
                Fear Free стандарт
            </span>
            <h3 class="fw-bold mb-3">Почему владельцы выбирают «ВетЗабота»?</h3>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-start gap-3">
                    <i class="bi bi-check2-circle fs-4 text-emerald" style="color: #059669;"></i>
                    <div>
                        <strong class="text-dark">Собственная цифровая лаборатория</strong>
                        <p class="text-secondary small mb-0">Клинический и биохимический анализ крови за 20 минут прямо на приёме.</p>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-3">
                    <i class="bi bi-check2-circle fs-4 text-emerald" style="color: #059669;"></i>
                    <div>
                        <strong class="text-dark">Бережный осмотр без стресса</strong>
                        <p class="text-secondary small mb-0">Специальные протоколы обращения минимизируют волнение собак и кошек.</p>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-3">
                    <i class="bi bi-check2-circle fs-4 text-emerald" style="color: #059669;"></i>
                    <div>
                        <strong class="text-dark">Электронная история болезни</strong>
                        <p class="text-secondary small mb-0">Все рекомендации, препараты и протоколы сохраняются в личном кабинете.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="p-4 rounded-4 text-center border" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);">
                <i class="bi bi-calendar-heart fs-1 text-emerald mb-2 d-inline-block" style="color: #10b981;"></i>
                <h5 class="fw-bold text-dark">Запишите питомца на приём</h5>
                <p class="text-secondary small mb-4">Выберите удобное время в несколько кликов</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Visits" asp-action="Create" class="btn btn-teal">
                        <i class="bi bi-pencil-square me-1"></i> Оформить запись
                    </a>
                    <a href="tel:+79005553535" class="btn btn-outline-secondary">
                        <i class="bi bi-telephone me-1"></i> Позвонить в регистратуру
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
