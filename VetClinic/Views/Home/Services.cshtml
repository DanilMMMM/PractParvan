@model IEnumerable<VetClinic.Models.Service>
@{
    ViewData["Title"] = "Услуги и цены";
}

<div class="mb-4">
    <h2 class="fw-bold text-dark"><i class="bi bi-card-checklist me-2 text-teal" style="color: #0d9488;"></i> Каталог услуг и прейскурант</h2>
    <p class="text-secondary">Ознакомьтесь с перечнем процедур, стоимостью и ориентировочной продолжительностью приёма.</p>
</div>

<!-- Search & Filter Card -->
<div class="card card-custom p-3 bg-white mb-4 border">
    <form method="get" asp-controller="Home" asp-action="Services" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Поиск услуги по названию или описанию..." 
                       value="@ViewBag.Search" />
            </div>
        </div>
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-cash-stack"></i> До</span>
                <input type="number" name="maxPrice" class="form-control" placeholder="Макс. цена (руб.)" 
                       value="@ViewBag.MaxPrice" step="100" min="0" />
                <span class="input-group-text bg-white">₽</span>
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-teal flex-grow-1">
                <i class="bi bi-funnel me-1"></i> Найти
            </button>
            <a asp-action="Services" class="btn btn-outline-secondary" title="Сбросить фильтры">
                <i class="bi bi-x-circle"></i>
            </a>
        </div>
    </form>
</div>

<!-- Services Grid -->
<div class="row g-3">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-search fs-1 text-muted"></i>
            <h5 class="text-muted mt-2">Услуги по заданным критериям не найдены</h5>
            <a asp-action="Services" class="btn btn-sm btn-outline-teal mt-2">Сбросить фильтры</a>
        </div>
    }
    else
    {
        @foreach (var s in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-custom h-100 p-3 bg-white d-flex flex-column justify-content-between border">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-dark mb-0">@s.Name</h5>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-stopwatch me-1"></i> @s.DurationMinutes мин
                            </span>
                        </div>
                        <p class="text-secondary small mb-3">@s.Description</p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <span class="fs-4 fw-bold text-dark">@s.Price.ToString("N0") ₽</span>
                        <a asp-controller="Visits" asp-action="Create" asp-route-serviceId="@s.Id" class="btn btn-teal btn-sm">
                            <i class="bi bi-calendar2-plus me-1"></i> Записаться
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>
