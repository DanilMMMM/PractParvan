@model VetClinic.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = $"Редактирование: {Model.FullName}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom p-4 bg-white border">
            <div class="d-flex align-items-center gap-3 border-bottom pb-3 mb-4">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fs-2" 
                     style="width: 60px; height: 60px;">
                    <i class="bi bi-person-gear"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark">Редактирование пользователя: @Model.FullName</h3>
                    <p class="text-muted small mb-0">Управление учетной записью, правами доступа и паролем</p>
                </div>
            </div>

            <form asp-action="UserEdit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Login" class="form-label fw-semibold"></label>
                        <input asp-for="Login" class="form-control" />
                        <span asp-validation-for="Login" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="RoleId" class="form-label fw-semibold text-danger">Роль пользователя (права)</label>
                        <select asp-for="RoleId" class="form-select border-danger" asp-items="ViewBag.Roles"></select>
                        <span asp-validation-for="RoleId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Specialization" class="form-label fw-semibold"></label>
                        <input asp-for="Specialization" class="form-control" placeholder="Для врачей (Терапевт, Хирург...)" />
                        <span asp-validation-for="Specialization" class="text-danger small"></span>
                    </div>
                </div>

                <div class="p-3 bg-light rounded border mb-4">
                    <label asp-for="NewPassword" class="form-label fw-semibold text-dark mb-1"></label>
                    <input asp-for="NewPassword" class="form-control" placeholder="Оставьте пустым, если не требуется менять текущий пароль" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    <small class="text-muted d-block mt-1">При заполнении пароль будет немедленно перехеширован.</small>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Users" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Назад к списку
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i> Сохранить данные
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
