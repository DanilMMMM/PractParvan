@model IEnumerable<VetClinic.Models.User>
@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Администратор</a></li>
                <li class="breadcrumb-item active" aria-current="page">Пользователи</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-dark mb-0">
            <i class="bi bi-people-fill text-primary me-2"></i> Управление пользователями и ролями
        </h2>
    </div>
    <div>
        <a asp-controller="Account" asp-action="Register" class="btn btn-teal">
            <i class="bi bi-person-plus me-1"></i> Зарегистрировать пользователя
        </a>
    </div>
</div>

<!-- Search & Filter -->
<div class="card card-custom p-3 bg-white mb-4 border">
    <form method="get" asp-action="Users" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Поиск по логину, ФИО, Email или телефону..." 
                       value="@ViewBag.Search" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="roleId" class="form-select" asp-items="ViewBag.Roles">
                <option value="">-- Все роли --</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-teal flex-grow-1">
                <i class="bi bi-funnel me-1"></i> Найти
            </button>
            <a asp-action="Users" class="btn btn-outline-secondary" title="Сбросить">
                <i class="bi bi-x-circle"></i>
            </a>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="card card-custom bg-white border overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase text-secondary">
                <tr>
                    <th>ID</th>
                    <th>Логин / ФИО</th>
                    <th>Контакты</th>
                    <th>Роль в системе</th>
                    <th>Специализация</th>
                    <th>Питомцев</th>
                    <th>Регистрация</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var roleBadge = u.Role?.Name switch
                    {
                        "Администратор" => "badge-role-admin",
                        "Ветеринар" => "badge-role-vet",
                        _ => "badge-role-client"
                    };

                    <tr>
                        <td class="text-muted small">#@u.Id</td>
                        <td>
                            <strong class="d-block text-dark">@u.FullName</strong>
                            <small class="text-muted"><i class="bi bi-person me-1"></i>@u.Login</small>
                        </td>
                        <td class="small">
                            <div><i class="bi bi-envelope me-1 text-muted"></i>@u.Email</div>
                            @if (!string.IsNullOrEmpty(u.Phone))
                            {
                                <div><i class="bi bi-telephone me-1 text-muted"></i>@u.Phone</div>
                            }
                        </td>
                        <td>
                            <span class="badge @roleBadge rounded-pill">@(u.Role?.Name ?? "Клиент")</span>
                        </td>
                        <td class="small text-secondary">
                            @(u.Specialization ?? "—")
                        </td>
                        <td class="text-center">
                            @if (u.Pets.Any())
                            {
                                <span class="badge bg-light text-dark border">@u.Pets.Count</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="small text-muted">
                            @u.CreatedAt.ToString("dd.MM.yyyy")
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="UserEdit" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Редактировать">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="UserDelete" asp-route-id="@u.Id" method="post" class="d-inline" 
                                      onsubmit="return confirm('Удалить пользователя @u.FullName (@u.Login)?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Удалить">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
