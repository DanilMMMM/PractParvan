@model VetClinic.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Панель администратора";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-speedometer2 text-danger me-2"></i> Панель управления клиникой
        </h2>
        <p class="text-secondary small mb-0">Сводные показатели, статистика приёмов, оперативное управление персоналом и каталогом услуг.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Users" class="btn btn-outline-secondary">
            <i class="bi bi-people me-1"></i> Пользователи (@Model.TotalUsers)
        </a>
        <a asp-action="Services" class="btn btn-teal">
            <i class="bi bi-tags me-1"></i> Прейскурант услуг
        </a>
    </div>
</div>

<!-- Modern Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-4 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.05em;">Пользователи</span>
                <div class="stat-icon stat-icon-indigo" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold text-dark mb-1">@Model.TotalUsers</h2>
            <small class="text-secondary">Клиентов: <strong>@Model.TotalClients</strong> &bull; Врачей: <strong>@Model.TotalVets</strong></small>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-4 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.05em;">Пациенты</span>
                <div class="stat-icon stat-icon-emerald" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1" style="color: #059669;">@Model.TotalPets</h2>
            <small class="text-secondary">Зарегистрированных питомцев</small>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-4 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.05em;">Всего приёмов</span>
                <div class="stat-icon stat-icon-amber" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold text-dark mb-1">@Model.TotalVisits</h2>
            <small class="text-secondary">Запланировано: <strong>@Model.PlannedVisits</strong> &bull; Завершено: <strong>@Model.CompletedVisits</strong></small>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-4 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.05em;">Выручка</span>
                <div class="stat-icon stat-icon-emerald" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
            <h2 class="fw-bold text-dark mb-1">@Model.TotalRevenue.ToString("N0") MDL</h2>
            <small class="text-secondary">По проведённым процедурам</small>
        </div>
    </div>
</div>

<!-- Recent Activities -->
<div class="row g-4">
    <!-- Recent Visits -->
    <div class="col-lg-8">
        <div class="card card-custom bg-white border p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history me-2 text-primary"></i> Последние приёмы клиники</h5>
                <a asp-controller="Visits" asp-action="Index" class="btn btn-sm btn-link text-decoration-none fw-semibold" style="color: #059669;">
                    Весь журнал &rarr;
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>Питомец</th>
                            <th>Клиент</th>
                            <th>Врач</th>
                            <th>Статус</th>
                            <th class="text-end">Сумма</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.RecentVisits)
                        {
                            var statusClass = v.Status switch
                            {
                                "Завершён" => "badge-status-completed",
                                "Запланирован" => "badge-status-planned",
                                "В процессе" => "badge-status-process",
                                _ => "badge-status-cancelled"
                            };

                            <tr>
                                <td class="small fw-semibold">@v.VisitDate.ToString("dd.MM.yy HH:mm")</td>
                                <td>
                                    <a asp-controller="Pets" asp-action="Details" asp-route-id="@v.PetId" class="text-decoration-none fw-semibold" style="color: #059669;">
                                        @v.Pet?.Name
                                    </a>
                                </td>
                                <td class="small">@v.Client?.FullName</td>
                                <td class="small">@v.Veterinarian?.FullName</td>
                                <td><span class="badge-pill-status @statusClass small">@v.Status</span></td>
                                <td class="text-end fw-bold small">@v.TotalCost.ToString("N0") MDL</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Users -->
    <div class="col-lg-4">
        <div class="card card-custom bg-white border p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-check-fill me-2 text-success"></i> Новые пользователи</h5>
                <a asp-action="Users" class="btn btn-sm btn-link text-decoration-none fw-semibold" style="color: #059669;">
                    Управление &rarr;
                </a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var u in Model.RecentUsers)
                {
                    var roleBadge = u.Role?.Name switch
                    {
                        "Администратор" => "badge-role-admin",
                        "Ветеринар" => "badge-role-vet",
                        _ => "badge-role-client"
                    };

                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <strong class="d-block text-dark small">@u.FullName</strong>
                            <small class="text-secondary">@u.Login | @u.Email</small>
                        </div>
                        <span class="badge @roleBadge small">@(u.Role?.Name ?? "Клиент")</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
