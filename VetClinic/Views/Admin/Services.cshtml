@model IEnumerable<VetClinic.Models.Service>
@{
    ViewData["Title"] = "Управление услугами клиники";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Администратор</a></li>
                <li class="breadcrumb-item active" aria-current="page">Прейскурант услуг</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-dark mb-0">
            <i class="bi bi-tags-fill text-success me-2"></i> Каталог ветеринарных услуг
        </h2>
    </div>
    <div>
        <a asp-action="ServiceCreate" class="btn btn-teal">
            <i class="bi bi-plus-lg me-1"></i> Добавить услугу
        </a>
    </div>
</div>

<div class="card card-custom bg-white border overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase text-secondary">
                <tr>
                    <th>ID</th>
                    <th>Название услуги</th>
                    <th>Описание</th>
                    <th>Длительность</th>
                    <th>Стоимость</th>
                    <th>Статус</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="text-muted small">#@s.Id</td>
                        <td>
                            <strong class="text-dark">@s.Name</strong>
                        </td>
                        <td class="small text-secondary" style="max-width: 320px;">
                            @(s.Description.Length > 85 ? s.Description.Substring(0, 82) + "..." : s.Description)
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-stopwatch me-1"></i>@s.DurationMinutes мин
                            </span>
                        </td>
                        <td>
                            <strong class="text-dark fs-6">@s.Price.ToString("N0") ₽</strong>
                        </td>
                        <td>
                            @if (s.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Активна</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">Отключена</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="ServiceEdit" asp-route-id="@s.Id" class="btn btn-outline-primary" title="Редактировать">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ServiceDelete" asp-route-id="@s.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Удалить или деактивировать услугу «@s.Name»?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Удалить">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
