@model VetClinic.ViewModels.DatabaseViewerViewModel
@{
    ViewData["Title"] = "Обозреватель базы данных (СУБД)";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-emerald-subtle text-emerald rounded-pill px-3 py-1 fw-bold" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
                <i class="bi bi-database-check me-1"></i> СУБД SQLite 3
            </span>
            <span class="badge bg-secondary rounded-pill px-3 py-1">ORM Entity Framework Core 9</span>
        </div>
        <h2 class="display-6 fw-bold mt-2 mb-1">
            <i class="bi bi-database me-2 text-emerald" style="color: #34d399;"></i>Обозреватель базы данных
        </h2>
        <p class="text-secondary mb-0">Прямой инспектор реляционной базы данных <code>vetclinic.db</code> для проверки структуры и записей.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Database" asp-route-table="@Model.SelectedTable" class="btn btn-outline-light rounded-pill px-3">
            <i class="bi bi-arrow-clockwise me-1"></i> Обновить данные
        </a>
    </div>
</div>

<!-- Карточки статуса СУБД -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-3 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="brand-icon-wrapper" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="bi bi-file-earmark-binary"></i>
                </div>
                <div class="overflow-hidden">
                    <small class="text-secondary d-block">Физический файл БД</small>
                    <strong class="text-white text-truncate d-block" title="@Model.DbPath">@Model.DbFileName</strong>
                    <small class="text-muted" style="font-size: 0.75rem;">@((Model.FileSizeBytes / 1024.0).ToString("F1")) КБ</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card card-custom p-3 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="brand-icon-wrapper" style="width: 44px; height: 44px; font-size: 1.25rem; background: linear-gradient(135deg, #0ea5e9, #0284c7);">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <div class="overflow-hidden">
                    <small class="text-secondary d-block">Путь на диске</small>
                    <code class="text-info text-truncate d-block" style="font-size: 0.8rem;" title="@Model.DbPath">@Model.DbPath</code>
                    <small class="text-muted" style="font-size: 0.75rem;">Изменён: @Model.LastModified.ToString("dd.MM.yyyy HH:mm:ss")</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="brand-icon-wrapper" style="width: 44px; height: 44px; font-size: 1.25rem; background: linear-gradient(135deg, #8b5cf6, #6366f1);">
                    <i class="bi bi-layers"></i>
                </div>
                <div>
                    <small class="text-secondary d-block">Всего таблиц</small>
                    <h5 class="text-white fw-bold mb-0">@Model.Tables.Count таблиц</h5>
                    <small class="text-emerald" style="color: #34d399; font-size: 0.75rem;"><i class="bi bi-check-circle me-1"></i>Нормализованы</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Навигация по таблицам базы данных -->
<div class="card card-custom p-3 mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <span class="text-secondary small text-uppercase fw-bold letter-spacing-1">Таблицы реляционной БД:</span>
        <span class="text-muted small">Нажмите на таблицу для просмотра строк</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var tbl in Model.Tables)
        {
            var isActive = tbl.Name.Equals(Model.SelectedTable, StringComparison.OrdinalIgnoreCase);
            <a asp-action="Database" asp-route-table="@tbl.Name" 
               class="btn @(isActive ? "btn-teal text-white shadow" : "btn-dark-glass") rounded-pill px-3 py-2 d-flex align-items-center gap-2">
                <i class="bi @(tbl.Name switch {
                    "Pets" => "bi-github",
                    "Visits" => "bi-calendar2-check",
                    "Users" => "bi-people",
                    "Roles" => "bi-shield-lock",
                    "Services" => "bi-tags",
                    _ => "bi-table"
                })"></i>
                <span>@tbl.DisplayName</span>
                <span class="badge @(isActive ? "bg-white text-dark" : "bg-secondary") rounded-pill">@tbl.RowCount</span>
            </a>
        }
    </div>
</div>

<!-- Поле для выполнения произвольного SQL-запроса -->
<div class="card card-custom p-3 mb-4">
    <div class="accordion accordion-flush bg-transparent" id="sqlAccordion">
        <div class="accordion-item bg-transparent border-0">
            <h2 class="accordion-header" id="headingSql">
                <button class="accordion-button collapsed bg-transparent text-white p-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSql" aria-expanded="false" aria-controls="collapseSql">
                    <span class="d-flex align-items-center gap-2">
                        <i class="bi bi-terminal text-emerald" style="color: #34d399;"></i>
                        <span class="fw-semibold">Консоль прямых SQL-запросов (SELECT)</span>
                        <span class="badge bg-dark border border-secondary text-secondary ms-2">Для преподавателя</span>
                    </span>
                </button>
            </h2>
            <div id="collapseSql" class="accordion-collapse collapse @(!string.IsNullOrWhiteSpace(Model.CustomSql) ? "show" : "")" aria-labelledby="headingSql">
                <div class="pt-3">
                    <form asp-action="Database" method="get" class="d-flex flex-column gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary font-monospace">SQL&gt;</span>
                            <input type="text" name="sqlQuery" value="@Model.CustomSql" class="form-control form-control-custom font-monospace" placeholder="Например: SELECT Id, Name, Age, Breed FROM Pets ORDER BY Id DESC;" />
                            <button type="submit" class="btn btn-teal px-4">
                                <i class="bi bi-play-fill me-1"></i> Выполнить SQL
                            </button>
                        </div>
                        <div class="d-flex gap-2 flex-wrap mt-1">
                            <span class="text-muted small">Быстрые запросы:</span>
                            <a href="?sqlQuery=SELECT+*+FROM+Pets" class="badge bg-dark-glass text-secondary text-decoration-none">SELECT * FROM Pets</a>
                            <a href="?sqlQuery=SELECT+*+FROM+Visits+ORDER+BY+Id+DESC" class="badge bg-dark-glass text-secondary text-decoration-none">SELECT * FROM Visits</a>
                            <a href="?sqlQuery=SELECT+Id,+Login,+FullName,+RoleId+FROM+Users" class="badge bg-dark-glass text-secondary text-decoration-none">SELECT Users</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SqlError))
{
    <div class="alert alert-danger rounded-4 d-flex align-items-center gap-3 mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
        <div>
            <strong>Ошибка базы данных:</strong> @Model.SqlError
        </div>
    </div>
}

<!-- Таблица с данными -->
<div class="card card-custom p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h4 class="fw-bold mb-0 text-white">
                <i class="bi bi-table text-emerald me-2" style="color: #34d399;"></i>
                Таблица: <span class="text-emerald" style="color: #34d399;">@Model.SelectedTable</span>
            </h4>
            <small class="text-secondary">Отображено записей: <strong>@Model.TotalRows</strong></small>
        </div>
        <div class="text-secondary small">
            <i class="bi bi-info-circle me-1"></i> Первичный ключ (PK): обычно колонка <code>Id</code>
        </div>
    </div>

    @if (Model.Rows.Any())
    {
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0 font-monospace" style="font-size: 0.88rem;">
                <thead>
                    <tr>
                        @foreach (var col in Model.ColumnNames)
                        {
                            <th class="text-uppercase" style="background: rgba(15, 23, 42, 0.9); color: #34d399; font-weight: 700; border-bottom: 2px solid #334155;">
                                @col
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @foreach (var cell in row)
                            {
                                <td>
                                    @if (cell == "NULL")
                                    {
                                        <span class="badge bg-secondary-subtle text-muted">NULL</span>
                                    }
                                    else
                                    {
                                        <span class="text-light">@cell</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-secondary">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            <p class="mb-0">В таблице пока нет записей или запрос вернул 0 строк.</p>
        </div>
    }
</div>

<!-- Памятка для студента для ответа преподавателю -->
<div class="card card-custom p-4 mt-4 border-emerald" style="border-left: 4px solid #10b981;">
    <h5 class="fw-bold text-white mb-2">
        <i class="bi bi-mortarboard-fill text-emerald me-2" style="color: #34d399;"></i>
        Шпаргалка для ответа преподавателю: «Как доказать, что база данных работает?»
    </h5>
    <ol class="text-secondary mb-0 ps-3" style="line-height: 1.8;">
        <li>
            <strong class="text-white">Показать эту страницу:</strong> Войдите под администратором, откройте <em>«Администрирование &rarr; База данных (СУБД)»</em>. Покажите преподавателю таблицы <code>Users</code>, <code>Pets</code>, <code>Visits</code>, <code>Services</code>.
        </li>
        <li>
            <strong class="text-white">Живая демонстрация записи:</strong> Откройте в новой вкладке <em>«Записаться на приём»</em> или <em>«Пациенты &rarr; Добавить»</em>, внесите нового питомца. Вернитесь на эту страницу, нажмите <em>«Обновить»</em> &mdash; новая строка сразу появится внизу таблицы с новым <code>Id</code> и датой!
        </li>
        <li>
            <strong class="text-white">Показать физический файл:</strong> Покажите файл <code>vetclinic.db</code> в папке <code>VetClinic/vetclinic.db</code>. Он увеличивается в размере при добавлении данных.
        </li>
        <li>
            <strong class="text-white">Показать код связей и ORM:</strong> Откройте в Visual Studio файл <code>Data/AppDbContext.cs</code> (там описаны внешние ключи <code>ForeignKey</code>, каскадное удаление) и <code>Controllers/VisitsController.cs</code> (метод <code>Create</code>, где вызывается <code>_context.Visits.Add(visit); await _context.SaveChangesAsync();</code>).
        </li>
    </ol>
</div>
